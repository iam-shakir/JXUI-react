{
  "name": "@jxui/react",
  "version": "2.4.0",
  "description": "Next-generation React + TypeScript component library and interactive workbench reimagining every Material UI component.",
  "homepage": "https://iam-shakir.github.io/JXUI-react/",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.mjs",
  "types": "./dist-lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-lib/index.mjs",
      "require": "./dist-lib/index.cjs",
      "types": "./dist-lib/types/src/index.d.ts"
    }
  },
  "files": [
    "dist-lib",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:site": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/jxuiLogic.test.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "motion": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
